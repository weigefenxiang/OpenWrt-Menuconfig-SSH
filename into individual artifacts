[32m+[m[32m## v19：MT798x 提示与逐文件 Artifact[m
[32m+[m
[32m+[m[32m### MT798x 提示[m
[32m+[m
[32m+[m[32m仅 `immortalwrt-mt798x` 显示，分为：[m
[32m+[m
[32m+[m[32m```text[m
[32m+[m[32mMT7981 / AX3000[m
[32m+[m[32mMT7986（AX4200、AX6000、AX7800）[m
[32m+[m[32mMT7986 / 256M Low Memory[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32m机型列表使用人工换行，保持终端可读性；不使用大量等号分隔。[m
[32m+[m
[32m+[m[32m### Artifact 前缀[m
[32m+[m
[32m+[m[32m在“检查并整理 `.config`”步骤中生成：[m
[32m+[m
[32m+[m[32m```text[m
[32m+[m[32mARTIFACT_PREFIX=配置基础名-运行号-Session号[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32m读取 `006.immortalwrt.config` 时示例：[m
[32m+[m
[32m+[m[32m```text[m
[32m+[m[32m006.immortalwrt-16-1[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32m没有读取已有配置时使用：[m
[32m+[m
[32m+[m[32m```text[m
[32m+[m[32mnew-config-16-1[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32m### 上传顺序[m
[32m+[m
[32m+[m[32m```text[m
[32m+[m[32m配置 Artifact[m
[32m+[m[32m→ 可选 make[m
[32m+[m[32m→ 固件逐个上传[m
[32m+[m[32m→ build-info Artifact[m
[32m+[m[32m→ 恢复最终成功或失败状态[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32m逐文件上传器：[m
[32m+[m
[32m+[m[32m```text[m
[32m+[m[32mtools/artifact-uploader/upload-firmware.mjs[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32m它扫描 `source/bin/targets/`，排除：[m
[32m+[m
[32m+[m[32m```text[m
[32m+[m[32mpackages/[m
[32m+[m[32m*.buildinfo[m
[32m+[m[32m*.manifest[m
[32m+[m[32mprofiles.json[m
[32m+[m[32msha256sums[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32m剩余每个文件单独上传，并写入 `ARTIFACT_INDEX.txt`。[m
[32m+[m
[32m+[m[32m构建失败时，存在的部分固件仍会尝试上传，随后 Job 最终保持失败状态。[m
